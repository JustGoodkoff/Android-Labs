<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:background="@drawable/item_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp"
    android:layout_marginLeft="16dp"
    android:layout_marginRight="16dp"
    android:layout_marginBottom="16dp">

    <ImageView
        android:id="@+id/song_picture"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="16dp"
        tools:ignore="ContentDescription" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/song_title"
            android:layout_width="184dp"
            android:layout_height="24dp"
            android:fontFamily="@font/roboto"
            android:text="@string/no_hey_lay"
            android:textColor="#E2E2E2"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/song_author"
            android:layout_width="184dp"
            android:layout_height="20dp"
            android:fontFamily="@font/roboto"
            android:text="@string/kali_uchis"
            android:textColor="#C3C7C7"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:gravity="center">

        <ImageButton
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:backgroundTint="#262E2F"
            android:src="@drawable/baseline_play_circle_filled_24"
            tools:ignore="ContentDescription" />
    </LinearLayout>

</LinearLayout>